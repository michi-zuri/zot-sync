{
  "name": "zot-sync",
  "version": "0.4.0",
  "private": true,
  "description": "Mirror Zotero libraries into PostgreSQL",
  "type": "module",
  "bin": {
    "zot-sync": "dist/zot-sync.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "elm-pages run ZotSync",
    "build": "elm-pages bundle-script ZotSync --output dist/zot-sync.mjs",
    "test": "npm run test:unit",
    "test:unit": "node script/tests/generate-fixtures.mjs && cd script && elm-test",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.mjs\"",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "elm": "0.19.1-6",
    "elm-pages": "3.6.0",
    "elm-test": "0.19.1-revision17",
    "lamdera": "0.19.3-1.5.0"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
